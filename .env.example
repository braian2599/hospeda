# ==================== HOSPEDÁ — Environment Variables ====================
# Copiar este archivo como .env y completar los valores

# ── Base de datos (Neon PostgreSQL) ──
# Formato: postgresql://USER:PASS@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secret-aqui
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cifrado de credenciales en BD (AES-256-GCM) ──
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=tu-encryption-key-de-64-hex-chars

# ── Rate limiting distribuido (Upstash Redis — opcional pero recomendado) ──
# Sin esto, el rate limiting funciona en memoria (por-instancia)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ── Email (Resend — configurar cuando tengas dominio propio) ──
# 1. Crear cuenta en https://resend.com
# 2. Verificar tu dominio en Resend (DNS: TXT, MX, DKIM, SPF)
# 3. Agregar RESEND_API_KEY y RESEND_FROM_DOMAIN
# 4. Instalar el paquete: bun add resend
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_DOMAIN=tudominio.com

# ── Google OAuth (opcional — login con Google) ──
# Pasos para obtener las credenciales:
# 1. Ir a https://console.cloud.google.com/apis/credentials
# 2. Crear un proyecto (o usar uno existente) → habilitar Google+ API
# 3. Crear credenciales → "OAuth client ID" → Application type: "Web application"
# 4. En "Authorized JavaScript origins":
#      http://localhost:3000  (dev)
#      https://tudominio.com  (prod)
# 5. En "Authorized redirect URIs" agregar:
#      http://localhost:3000/api/auth/callback/google
#      https://tudominio.com/api/auth/callback/google
# 6. Copiar el Client ID y Client Secret acá abajo:
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ── Super Admin ──
SUPER_ADMIN_EMAILS=admin@hospeda.app

# ── Optional: SMS (Twilio) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Optional: Payments ──
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
