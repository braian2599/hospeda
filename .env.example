# ==================== HOSPEDÁ — Environment Variables ====================
# Copiar este archivo como .env y completar los valores

# ── Base de datos (Neon PostgreSQL) ──
# Formato: postgresql://USER:PASS@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secret-aqui
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Gmail SMTP) ──
# 1. Activar 2FA en la cuenta Gmail
# 2. Ir a https://myaccount.google.com/apppasswords
# 3. Crear una "App password" para Hospedá
# 4. Usar los 16 caracteres como SMTP_PASS (sin espacios)
SMTP_USER=hospeda.notificaciones@gmail.com
SMTP_PASS=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ── Super Admin ──
SUPER_ADMIN_EMAILS=admin@hospeda.app

# ── Optional: SMS (Twilio) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Optional: Payments ──
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
