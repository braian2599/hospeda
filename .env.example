# ==================== HOSPEDÁ — Environment Variables ====================
# Copiar este archivo como .env y completar los valores

# ── Base de datos (SQLite) ──
# LOCAL: file:./db/custom.db  (ruta relativa al directorio del proyecto)
# VERCEL/Railway: usar /tmp/hospeda.db o migrar a PostgreSQL
DATABASE_URL=file:./db/custom.db

# ── NextAuth ──
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu-secret-aqui

# ── Google OAuth ──
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ── Super Admin ──
SUPER_ADMIN_EMAILS=admin@hospeda.app

# ── Optional: SMS (Twilio) ──
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Optional: Payments ──
# MERCADOPAGO_ACCESS_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
