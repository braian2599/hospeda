// ==================== HOSPEDÁ — SCHEMA MULTI-TENANT ====================
// Cada tabla tiene tenantId para aislar datos por hotel/empresa.
// Schema para PostgreSQL (producción). En desarrollo/sandbox con SQLite
// se usa @prisma/adapter-better-sqlite3 en db.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// TENANT & AUTH
// ═══════════════════════════════════════════════════════════

model Tenant {
  id             String            @id @default(cuid())
  nombre         String
  slug           String            @unique
  email          String
  telefono       String?
  direccion      String?
  ciudad         String?
  provincia      String?
  pais           String            @default("Argentina")
  moneda         String            @default("ARS")
  horaCheckin    String?
  horaCheckout   String?
  politicaCancelacion String?
  mapaLat        Float?
  mapaLng        Float?
  instagramUrl   String?
  facebookUrl    String?
  timezone       String            @default("America/Argentina/Buenos_Aires")
  logoUrl        String?
  descripcion    String?
  fotos          String[]          @default([])
  servicios      String[]          @default([])
  activo         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relaciones
  subscription    Subscription?
  users           TenantUser[]
  habitaciones    Habitacion[]
  clientes        Cliente[]
  reservas        Reserva[]
  pagos           Pago[]
  tarifas        Tarifa[]
  metodosPago    MetodoPago[]
  gastos         Gasto[]
  categoriasGasto CategoriaGasto[]
  movimientosCaja MovimientoCaja[]
  turnosCaja     TurnoCaja[]
  mantenimientos  Mantenimiento[]
  auditoria      Auditoria[]
  tareasLimpieza TareaLimpieza[]
  configuracion  TenantConfig?
  platformPayments PlatformPayment[]
  mercadoPago    TenantMercadoPago?
  afip           TenantAfip?
  comprobantes   Comprobante[]
  comprobanteContadores ComprobanteContador[]
  titularesCuenta       TitularCuenta[]
  cargosCuentaCorriente CargoCuentaCorriente[]
  pagosCuentaCorriente  PagoCuentaCorriente[]
  channex               ChannexConexion?
  channexTipos          ChannexTipo[]
  channexTarifas        ChannexTarifa[]
  channexReservas       ChannexReserva[]
  promociones           Promocion[]
  paquetes              Paquete[]
}

// ═══════════════════════════════════════════════════════════
// PLANES & SUSCRIPCIONES
// ═══════════════════════════════════════════════════════════

model Plan {
  id              String         @id @default(cuid())
  type            PlanType       @unique
  nombre          String
  precioMensual   Int
  moneda          String         @default("ARS")
  maxHabitaciones Int
  maxUsuarios     Int
  maxTarifas      Int
  maxReservasMes  Int
  modulos         Json
  featureFlags    Json           @default("{}")
  activo          Boolean        @default(true)
  // Cambio de precio para los hoteles que ya tienen débito automático.
  // precioMensual es el precio nuevo (lo pagan ya los que se suscriben de
  // nuevo); los débitos que ya existen siguen con el monto que autorizaron
  // hasta cambioPrecioDesde (un día 10), cuando la revisión diaria les
  // actualiza el monto en Mercado Pago. precioAnteriorMensual es el que
  // pagaban, para el aviso del panel. null = sin cambio programado.
  precioAnteriorMensual Int?
  cambioPrecioDesde     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  planId            String
  estado            String    @default("trial")
  /// De dónde salió este plan: trial | mercadopago | stripe | transferencia | cortesia.
  /// Lo escribe quien toca la suscripción. NO se deduce después: un hotel que
  /// pagó por transferencia en marzo y al que se le regala abril tiene un pago
  /// viejo que lo haría pasar por pagador. Por defecto 'cortesia' a propósito:
  /// si alguien agrega un camino nuevo y se olvida de setearlo, el sistema
  /// avisa de más (dice que nadie pagó) en vez de prometer en silencio una
  /// renovación automática que no existe.
  origen            String    @default("cortesia")
  fechaInicio       DateTime  @default(now())
  fechaVencimiento  DateTime
  trialUsado        Boolean   @default(false)
  paymentProviderId String?
  canceladaAt       DateTime?
  esRecurrente      Boolean   @default(false)
  mpPlanId          String?
  mpPreapprovalId   String?   @unique
  stripeSubscriptionId String? @unique
  proximoCobro      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan              Plan      @relation(fields: [planId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// USUARIOS & AUTH
// ═══════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  tenantId     String   @default("")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  password      String?
  phone         String?      @unique
  phoneVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  tenants       TenantUser[]
}

model TenantUser {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  rol            RolTenant @default(recepcion)
  nombreCompleto String?
  permisos       String[]
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  password       String?
  // Cuantas veces vio cada aviso de inicio de sesion (bienvenida y novedades).
  // Clave = id del aviso, valor = veces mostradas. Ver src/lib/avisos.ts.
  avisosVistos   Json      @default("{}")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// HABITACIONES
// ═══════════════════════════════════════════════════════════

model Habitacion {
  id                 String           @id @default(cuid())
  tenantId           String
  numero             String
  tipo               String
  capacidad          Int
  camasMatrimoniales Int
  camasSimples       Int
  estado             EstadoHabitacion @default(Disponible)
  problema           String?
  bloqueaDisponibilidad Boolean       @default(true)
  bloqueadoHasta     DateTime?
  precioPorCama      Int?
  piso               Int?
  orden              Int              @default(0)
  fotos              String[]         @default([])
  descripcion        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numero])
}

// ═══════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════

model Cliente {
  id              String    @id @default(cuid())
  tenantId        String
  nombre          String
  dni             String
  telefono        String
  email           String?
  fechaNacimiento DateTime?
  nacionalidad    String?
  preferencias    String    @default("")
  domicilio       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estadias        Estadia[]
  reservas        Reserva[]
  // Sus datos fiscales, si alguna vez pidió factura con CUIT. Es la pestaña
  // "Datos fiscales" de la ficha. Ver docs/cuenta-corriente.md.
  titularCuenta   TitularCuenta?

  @@unique([tenantId, dni])
}

model Estadia {
  id            String   @id @default(cuid())
  tenantId      String
  clienteId     String
  fechaCheckin  DateTime
  fechaCheckout DateTime
  habitacion    String
  gastoTotal    Int
  createdAt     DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// RESERVAS
// ═══════════════════════════════════════════════════════════

model Reserva {
  id                       String        @id @default(cuid())
  tenantId                 String
  // Número corto por hotel (#1, #2…), para distinguir reservas a simple
  // vista. Lo pone la base al crearla (trigger "reserva_numero", ver la
  // migración 20260928_numero_reserva): el código no lo manda nunca.
  numero                   Int?
  clienteId                String?
  huesped                  String
  dni                      String
  telefono                 String
  email                    String?
  domicilio                String?
  habitacion               String
  checkin                  DateTime
  checkout                 DateTime
  personas                 Int
  estadoPago               EstadoPago    @default(Pendiente)
  estado                   EstadoReserva @default(Confirmada)
  tipoTarifa               String?
  metodoPagoId             String?
  cuotas                   Int?
  recargoPorcentaje        Int?
  notas                    String        @default("")
  observacionesHuesped     String?
  agenciaNombre            String?
  agenciaConvenio          String?
  agenciaVendedor          String?
  contactoEmergenciaNombre String?
  contactoEmergenciaTel    String?
  llaveEntregada           String?
  documentoVerificado      Boolean       @default(false)
  firmaConformidad         Boolean       @default(false)
  horaCheckin              String?
  horaCheckout             String?
  ninos                    Int?
  total                    Int?
  datosAdicionales         Json?
  origen                   String        @default("directo")
  externalUid              String?
  reservaVinculadaId       String?       @unique
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // Numeración de comprobante — se asigna una única vez, de forma atómica,
  // la primera vez que se emite/visualiza el RECIBO de esta reserva (post
  // check-out; antes de eso el documento es una "Cotización" sin validez
  // fiscal y no consume numeración). Ver POST /api/reservas/[id]/comprobante.
  // Se guarda como snapshot (no se recalcula) para que el número impreso no
  // cambie aunque después se edite el punto de venta en Configuración.
  comprobanteNumero        Int?
  comprobantePuntoVenta    Int?
  comprobanteFecha         DateTime?
  // Si el comprobante fue autorizado por AFIP (CAE real, no solo interno),
  // se completan estos campos. comprobanteAmbiente distingue un CAE de
  // homologación (pruebas, sin validez fiscal) de uno de producción, para
  // que nunca se confunda un comprobante de prueba con uno real.
  comprobanteCae           String?
  comprobanteCaeVencimiento DateTime?
  comprobanteTipoAfip      Int?
  comprobanteAmbiente      String?
  // Número interno (recibo) que tenía este comprobante ANTES de facturarse
  // con AFIP — ver POST /api/reservas/[id]/facturar-afip. El check-out ya
  // no factura solo: siempre asigna primero este número interno, y recién
  // si más adelante se factura con AFIP, comprobanteNumero pasa a ser el
  // número oficial de AFIP (una numeración totalmente distinta) y el
  // interno queda acá como referencia, para no perder el rastro de qué
  // recibo se convirtió en qué factura.
  comprobanteNumeroInterno Int?

  acompanantes             Acompanante[]
  menores                  Menor[]
  pagos                    Pago[]
  comprobantes             Comprobante[]
  // Si el saldo se pasó a cuenta corriente. Como mucho uno: se deriva completo.
  cargoCuentaCorriente     CargoCuentaCorriente?
  cliente                  Cliente?      @relation(fields: [clienteId], references: [id])
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservaVinculada         Reserva?      @relation("ReservaVinculada", fields: [reservaVinculadaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reservaVinculadaDe       Reserva?      @relation("ReservaVinculada")

  @@index([tenantId, estado])
  @@index([tenantId, habitacion, checkin, checkout])
  @@unique([tenantId, externalUid])
  @@unique([tenantId, numero])
  // Evita números de comprobante duplicados dentro del mismo punto de
  // venta. Postgres no considera duplicados los NULL, así que las reservas
  // sin comprobante emitido todavía no chocan entre sí.
  @@unique([tenantId, comprobantePuntoVenta, comprobanteNumero])
}

model Acompanante {
  id        String  @id @default(cuid())
  reservaId String
  nombre    String
  dni       String
  celular   String?

  reserva   Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
}

model Menor {
  id         String  @id @default(cuid())
  reservaId  String
  nombre     String
  documento  String
  edad       Int
  parentesco String

  reserva    Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([reservaId])
}

// ═══════════════════════════════════════════════════════════
// PAGOS
// ═══════════════════════════════════════════════════════════

model Pago {
  id        String   @id @default(cuid())
  tenantId  String
  reservaId String
  monto     Int
  metodo    String
  nota      String   @default("")
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movimientoCaja MovimientoCaja?

  @@index([tenantId, reservaId])
}

// ═══════════════════════════════════════════════════════════
// TARIFAS
// ═══════════════════════════════════════════════════════════

model Tarifa {
  id                   String   @id @default(cuid())
  tenantId             String
  nombre               String
  precios              Json
  camposPersonalizados Json?
  choferCortesia       Boolean  @default(false)
  habitacionChofer     String?
  promoDescripcion     String?
  activa               Boolean  @default(true)
  // Período en que vale la tarifa (las dos opcionales: sin fechas, vale
  // siempre). Medianoche UTC, como las fechas de las reservas. La regla
  // (decisión del dueño, 02/10): una tarifa vale para una estadía si está
  // vigente el DÍA DE SALIDA, y entonces cobra la estadía entera con ella,
  // sin mezclar tarifas. Ver src/lib/tarifa-vigencia.ts.
  vigenciaDesde        DateTime?
  vigenciaHasta        DateTime?
  // Si aparece en la pestaña Promociones de la página web. Lo decide el
  // dueño en cada tarifa: antes salía sola cualquier tarifa con una promoción
  // prendida (también, por ejemplo, la de agencias con chofer sin cargo).
  mostrarEnWeb         Boolean  @default(false)
  orden                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MÉTODOS DE PAGO
// ═══════════════════════════════════════════════════════════

model MetodoPago {
  id        String         @id @default(cuid())
  tenantId  String
  nombre    String
  tipo      TipoMetodoPago
  recargo   Boolean        @default(false)
  cuotas    Json?
  activo    Boolean        @default(true)
  orden     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// CAJA
// ═══════════════════════════════════════════════════════════

model TurnoCaja {
  id                String           @id @default(cuid())
  tenantId          String
  estado            String           @default("abierta")
  montoInicial      Int
  empleadoId        String
  empleadoNombre    String
  fechaApertura     DateTime         @default(now())
  fechaCierre       DateTime?
  saldoEsperado     Int?
  saldoContado      Int?
  diferencia        Int?
  billetes          Json?
  totalOtrosMetodos Int?
  notas             String?
  discrepancyExplain String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  movimientos       MovimientoCaja[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MovimientoCaja {
  id             String             @id @default(cuid())
  tenantId       String
  turnoId        String
  tipo           TipoMovimientoCaja
  monto          Int
  descripcion    String             @default("")
  metodo         String             @default("Efectivo")
  empleadoId     String?
  empleadoNombre String
  reservaId      String?
  fecha          DateTime           @default(now())
  createdAt      DateTime           @default(now())
  gastoId        String?            @unique
  // El cobro de una cuenta corriente que generó este ingreso. Mismo patrón
  // que gastoId: la tabla de negocio es la fuente de verdad y la caja
  // guarda su espejo, para que el cierre de turno lo cuente.
  pagoCuentaCorrienteId String?     @unique
  // El pago de reserva que generó este ingreso. Mismo patrón que gastoId: el
  // pago (en la reserva) es la fuente de verdad y la caja guarda su espejo.
  // Con este vínculo, corregir el monto del pago desde la reserva corrige
  // también este ingreso. Solo lo lleva el ingreso original, no los ajustes.
  pagoId         String?            @unique

  gasto          Gasto?             @relation(fields: [gastoId], references: [id])
  pago           Pago?              @relation(fields: [pagoId], references: [id])
  pagoCuentaCorriente PagoCuentaCorriente? @relation(fields: [pagoCuentaCorrienteId], references: [id])
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turno          TurnoCaja          @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([tenantId, turnoId])
  @@index([tenantId, gastoId])
}

// ═══════════════════════════════════════════════════════════
// GASTOS
// ═══════════════════════════════════════════════════════════

model Gasto {
  id             String          @id @default(cuid())
  tenantId       String
  tipo           String
  descripcion    String
  monto          Int
  fecha          DateTime
  empleadoId     String?
  empleado       String
  fuente         String?
  // Forma de pago (nombre de un MetodoPago del hotel). Los gastos de la caja
  // llevan la de su movimiento; los cargados en Reportes no tocan la caja.
  metodo         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  movimientoCaja MovimientoCaja?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fecha])
  @@index([tenantId, fuente])
}

model CategoriaGasto {
  id       String @id @default(cuid())
  tenantId String
  nombre   String
  orden    Int    @default(0)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MANTENIMIENTO
// ═══════════════════════════════════════════════════════════

model Mantenimiento {
  id         String   @id @default(cuid())
  tenantId   String
  habitacion String
  problema   String
  reparacion String?
  monto      Int?
  fecha      DateTime @default(now())
  empleado   String
  resuelto   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resuelto])
}

// ═══════════════════════════════════════════════════════════
// LIMPIEZA
// ═══════════════════════════════════════════════════════════

model TareaLimpieza {
  id              String              @id @default(cuid())
  tenantId        String
  habitacion      String
  estado          EstadoTareaLimpieza @default(pendiente)
  prioridad       String              @default("normal")  // urgente, normal, baja
  tipo            String              @default("limpieza") // limpieza, mantenimiento, preparacion, inspeccion
  empleadoId      String?
  empleado        String?
  nota            String?
  fechaCreacion   DateTime            @default(now())
  fechaCompletado DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, estado])
}

// ═══════════════════════════════════════════════════════════
// AUDITORÍA
// ═══════════════════════════════════════════════════════════

model Auditoria {
  id         String   @id @default(cuid())
  tenantId   String
  tipo       String
  detalle    String
  empleadoId String?
  empleado   String
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACIÓN DEL TENANT
// ═══════════════════════════════════════════════════════════

model TenantConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tema                String   @default("system")
  sidebarFijo         Boolean  @default(true)
  moduloInicio        String   @default("dashboard")
  hotelNombre         String?
  hotelRazonSocial    String?
  hotelDireccion      String?
  hotelCiudad         String?
  hotelPais           String?
  hotelTelefono       String?
  hotelEmail          String?
  hotelCuit           String?
  hotelIva            String?
  hotelLogoUrl        String?
  facturaLogoUrl      String?
  precioPorCamaGlobal Int?
  puntoVenta          Int?
  // Cantidad de comprobantes ya emitidos (0 = ninguno todavía). El próximo
  // número a asignar es numeroFactura + 1. Se incrementa de forma atómica en
  // POST /api/pagos/[id]/comprobante. Solo puede reconfigurarse manualmente
  // (numeroInicio) mientras siga en 0 — ver /api/configuracion/fiscal.
  numeroFactura       Int      @default(0)
  featureFlags        Json     @default("{}")
  tarifasPublicas     Json     @default("{}")
  mostrarSeccionAgencias Boolean @default(false)
  textoAgencias       String?
  modoCobroSena       String   @default("mercadopago")
  senaWhatsapp        String?
  senaEmail           String?
  senaInstrucciones   String?
  // Límite de fechas para reservas hechas desde la landing pública — los
  // hoteles habilitan la venta por temporada (cambian precios en Tarifas
  // seguido) y no quieren que alguien reserve fechas de una temporada que
  // todavía no cargaron. null = sin límite. Es un tope duro para la landing
  // (calendario + validación en el servidor); el personal sigue pudiendo
  // cargar una reserva a mano más allá de esta fecha desde el módulo
  // Reservas (ahí solo se le avisa, no se le bloquea).
  reservasHabilitadasHasta DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// MERCADO PAGO CONNECT — cuenta propia de cada hotel (para
// cobrar señas de reservas de la landing directo a su cuenta)
// ═══════════════════════════════════════════════════════════

model TenantMercadoPago {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  mpUserId     String?
  accessToken  String    // cifrado (AES-256-GCM, ver lib/crypto.ts)
  refreshToken String    // cifrado
  publicKey    String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// AFIP/ARCA — Facturación electrónica (WSAA + WSFEv1)
// Certificado propio por hotel (cada CUIT necesita el suyo).
// La clave privada se guarda cifrada (AES-256-GCM, ver lib/crypto.ts);
// el certificado (parte pública) se guarda en texto plano, no es secreto.
// ═══════════════════════════════════════════════════════════

model TenantAfip {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  cuit             String    // solo dígitos, sin guiones (11 dígitos)
  ambiente         String    @default("homologacion") // 'homologacion' | 'produccion'
  certificadoPem   String?   // certificado X.509 (.crt/.pem) — no es secreto
  clavePrivadaPem  String?   // clave privada — cifrada
  activo           Boolean   @default(false) // true = certificado cargado, listo para usar
  // Ticket WSAA cacheado (válido ~12hs) — evita volver a autenticar en cada
  // emisión, algo que además AFIP rate-limitea. Ver lib/afip/wsaa.ts.
  wsaaToken        String?
  wsaaSign         String?
  wsaaExpiracion   DateTime?
  // Ticket WSAA del servicio de consulta de CUIT (ws_sr_constancia_inscripcion).
  // ARCA da un ticket DISTINTO por servicio y no entrega otro mientras el
  // anterior siga vigente (coe.alreadyAuthenticated), así que no puede
  // compartir las columnas de arriba, que son las de facturar (wsfe).
  wsaaPadronToken      String?
  wsaaPadronSign       String?
  wsaaPadronExpiracion DateTime?
  ultimaConexionOk DateTime? // último login WSAA exitoso (botón "Probar conexión")
  ultimoError      String?
  // Cuándo avisó el hotel que le delegó la facturación a Hospeda en ARCA.
  // Mientras tenga fecha, aparece en el panel de Super Admin para aceptarla.
  // Se borra cuando la delegación se verifica. Ver lib/afip/delegacion.ts.
  delegacionAvisadaEn DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// COMPROBANTES — ledger genérico para Remito, Presupuesto
// (formal), Nota de Crédito y Nota de Débito. La Factura sigue
// viviendo en Reserva.comprobante* (numeración AFIP/interna ya
// probada, no se toca) pero también se refleja acá con una fila
// espejo para que Reportes y las Notas de Crédito/Débito tengan
// una única tabla desde donde consultar "todos los comprobantes
// emitidos", sin importar el tipo.
// ═══════════════════════════════════════════════════════════

model Comprobante {
  id                    String            @id @default(cuid())
  tenantId              String
  tipo                  TipoComprobante
  puntoVenta            Int
  numero                Int
  letra                 String            // 'B' | 'C' (Factura/Nota) | 'R' (Remito) | 'X' (Presupuesto, sin validez fiscal)
  fecha                 DateTime          @default(now())

  reservaId             String?
  reserva               Reserva?          @relation(fields: [reservaId], references: [id], onDelete: SetNull)

  // Notas de Crédito/Débito: el comprobante que están ajustando.
  comprobanteAsociadoId String?
  comprobanteAsociado   Comprobante?      @relation("ComprobanteAsociado", fields: [comprobanteAsociadoId], references: [id], onDelete: SetNull)
  notasAsociadas        Comprobante[]     @relation("ComprobanteAsociado")

  razonSocialReceptor   String
  docTipoReceptor       Int?
  docReceptor           String?
  domicilioReceptor     String?
  condicionIvaReceptor  String?

  concepto              String
  importe               Int               // centavos
  motivo                String?           // solo Notas de Crédito/Débito

  // Si en el futuro se conecta a AFIP (hoy es "interno" para todo lo que
  // no sea Factura), se completan estos campos igual que en Reserva.
  cae                   String?
  caeVencimiento        DateTime?
  tipoAfip              Int?
  ambiente              String?

  estado                String            @default("emitido") // 'emitido' | 'anulado'
  anuladoAt             DateTime?         // solo Remito/Presupuesto pueden anularse — Factura y Notas de Crédito/Débito son permanentes.

  // Número interno (Recibo) que tenía este comprobante antes de facturarse
  // con AFIP — solo aplica a tipo Factura. Ver comprobanteNumeroInterno en
  // Reserva para más contexto.
  numeroInterno         Int?

  // A qué titular de cuenta corriente se le emitió. Los datos del receptor
  // de arriba son una foto del momento (lo que salió impreso); esto es para
  // poder listar "todos los comprobantes de esta empresa" sin buscar por texto.
  titularCuentaId       String?
  titularCuenta         TitularCuenta?    @relation(fields: [titularCuentaId], references: [id], onDelete: SetNull)

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo, puntoVenta, numero])
  @@index([tenantId, reservaId])
  @@index([tenantId, tipo])
  @@index([titularCuentaId])
}

// Numeración atómica por tenant + tipo + punto de venta (mismo patrón de
// "reclamar con UPDATE condicional" que ya usa TenantConfig.numeroFactura,
// ver POST /api/comprobantes). Solo se usa para los tipos que no tienen ya
// su propio contador (Remito, Presupuesto, Nota de Crédito, Nota de Débito).
model ComprobanteContador {
  id           String          @id @default(cuid())
  tenantId     String
  tipo         TipoComprobante
  puntoVenta   Int
  ultimoNumero Int             @default(0)

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo, puntoVenta])
}

// ═══════════════════════════════════════════════════════════
// CUENTA CORRIENTE — empresas y clientes habituales que pagan después.
// Las decisiones detrás de esto están en docs/cuenta-corriente.md.
//
// No es un método de pago: /api/pagos mete todo pago en la caja y rechaza
// reservas con check-out. Por eso son dos acciones propias:
//   derivar la deuda → CargoCuentaCorriente (no toca la caja: no entró plata)
//   cobrarla         → PagoCuentaCorriente  (sí toca la caja: entró plata)
//
// El saldo NO se guarda en ningún lado: es la suma de los cargos menos la
// suma de los pagos, calculada cada vez. Un total guardado se desincroniza.
// ═══════════════════════════════════════════════════════════

model TitularCuenta {
  id               String      @id @default(cuid())
  tenantId         String
  tipo             TipoTitular
  // Razón social (empresa) o nombre y apellido (persona). Puede ser distinto
  // del nombre del huésped: el monotributista que factura con nombre de fantasía.
  nombre           String
  // Solo dígitos, 11. Con esto ARCA devuelve el resto. Obligatorio en una
  // empresa. Una persona puede no tenerlo: el huésped que se va debiendo
  // queda con su DNI (documento) y se le factura a Consumidor Final.
  // La base exige CUIT o DNI, y CUIT en toda empresa (migración
  // 20260929_cuenta_corriente_cliente).
  cuit             String?
  // Solo dígitos. El DNI de la persona, copiado de su ficha al abrirle la
  // cuenta: así la cuenta no depende de que la ficha siga existiendo.
  documento        String?
  // Tal como lo devuelve ARCA (o como se cargó a mano). Decide la letra de la
  // factura junto con la condición del hotel.
  condicionIva     String?
  domicilioFiscal  String?
  contactoNombre   String?
  contactoTelefono String?
  contactoEmail    String?
  // Centavos. null = sin límite. Por ahora es informativo: falta decidir si
  // bloquea la derivación o solo avisa.
  limiteCredito    Int?
  // Solo tipo persona: su ficha de huésped, para no tenerlo dos veces.
  // Si se borra el cliente, el titular queda (tiene CUIT e historial de deuda).
  clienteId        String?     @unique
  // Se desactiva, no se borra: tiene cargos y pagos que tienen que seguir ahí.
  activo           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente          Cliente?               @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cargos           CargoCuentaCorriente[]
  pagos            PagoCuentaCorriente[]
  comprobantes     Comprobante[]

  @@unique([tenantId, cuit])
  @@unique([tenantId, documento])
}

// La deuda de una reserva que se pasó a cuenta corriente. Se deriva el saldo
// COMPLETO y una sola vez (reservaId único): "el que anota fiado anota todo".
model CargoCuentaCorriente {
  id             String        @id @default(cuid())
  tenantId       String
  titularId      String
  reservaId      String        @unique
  // Centavos. Foto del saldo al momento de derivar: si después alguien toca
  // la reserva, lo que se le anotó al titular no cambia solo.
  monto          Int
  // La línea del estado de cuenta, tal como quedó al derivar
  // ("Juan Pérez — Hab. 203 — 15/09 al 18/09").
  concepto       String
  // Quién lo derivó: el perfil (TenantUser), no la cuenta. Igual que la auditoría.
  empleadoId     String?
  empleadoNombre String
  fecha          DateTime      @default(now())
  createdAt      DateTime      @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict: no se puede borrar un titular ni una reserva que tienen una
  // deuda anotada. El titular se desactiva; la reserva se cancela.
  // Borrar un hotel entero (super-admin, en cascada) sí funciona: probado.
  titular        TitularCuenta @relation(fields: [titularId], references: [id], onDelete: Restrict)
  reserva        Reserva       @relation(fields: [reservaId], references: [id], onDelete: Restrict)

  @@index([tenantId, titularId])
}

// El cobro de lo que debe un titular. Puede ser parcial (la derivación no,
// el cobro sí) y no está atado a una reserva: puede saldar varias juntas.
// Exige turno de caja abierto y deja su espejo en MovimientoCaja.
model PagoCuentaCorriente {
  id             String          @id @default(cuid())
  tenantId       String
  titularId      String
  monto          Int             // centavos
  metodo         String
  nota           String          @default("")
  empleadoId     String?
  empleadoNombre String
  fecha          DateTime        @default(now())
  createdAt      DateTime        @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  titular        TitularCuenta   @relation(fields: [titularId], references: [id], onDelete: Restrict)
  movimientoCaja MovimientoCaja?

  @@index([tenantId, titularId])
}

// ═══════════════════════════════════════════════════════════
// SUPER ADMIN — CONFIGURACIÓN DE PLATAFORMA
// ═══════════════════════════════════════════════════════════

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PlatformPayment {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String
  monto          Int
  moneda         String   @default("ARS")
  metodo         String   @default("mercadopago")
  estado         String   @default("pendiente")
  periodoDesde   DateTime
  periodoHasta   DateTime
  externalId     String?  @unique
  nota           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([estado, createdAt])
}

/// Avisos por email de la plataforma a los dueños de los hoteles (Super Admin → Avisos).
model AvisoPlataforma {
  id         String   @id @default(cuid())
  /// mantenimiento | novedad | importante
  tipo       String
  asunto     String
  mensaje    String
  /// Solo mantenimiento: día (YYYY-MM-DD) y horario (HH:MM), hora de Argentina.
  dia        String?
  desde      String?
  hasta      String?
  /// Tipos de plan a los que se mandó. Vacío = todos los hoteles activos.
  planes     String[] @default([])
  total      Int      @default(0)
  enviados   Int      @default(0)
  /// Hoteles a los que no les salió: [{ hotel, email }].
  fallidos   Json     @default("[]")
  creadoPor  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Emails automáticos ya mandados (src/lib/payments/avisos-suscripcion.ts).
/// La clave dice qué email y de qué (por ejemplo "cobro-aprobado:<suscripción>:<hasta>"):
/// el mismo aviso puede llegar dos veces (webhook y revisión diaria) y el email sale una sola.
model EmailEnviado {
  clave     String   @id
  tenantId  String?
  tipo      String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// CANALES DE VENTA (Channex) — Booking, Airbnb y otros por su API
// Ver src/lib/channex/.
// ═══════════════════════════════════════════════════════════

/// La conexión del hotel con Channex: un hotel en Hospi = una "property" allá.
model ChannexConexion {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  propertyId    String    @unique
  /// Si se conectó contra la cuenta de prueba de Channex (staging).
  modoPrueba    Boolean   @default(true)
  /// Secreto de la URL del webhook: Channex lo manda en cada aviso.
  webhookToken  String    @unique
  webhookId     String?
  /// Lo último que se mandó a Channex (disponibilidad y precios por día),
  /// para mandar solo lo que cambió.
  ultimoEnvio   Json      @default("{}")
  ultimoEnvioAt DateTime?
  ultimoError   String?
  ultimoErrorAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Promoción de la página web del hotel. La crea el dueño en Configuración →
/// Página web → Promociones. Se cobra con la tarifa elegida y vale para
/// estadías con entrada y salida dentro de [desde, hasta].
model Promocion {
  id          String   @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  fotoUrl     String?
  desde       DateTime @db.Date
  hasta       DateTime @db.Date
  terminos    String?
  tarifaId    String
  activa      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, hasta])
}

/// Paquete de la página web del hotel (alojamiento con excursiones y otros
/// servicios, por ejemplo armado con una agencia). Se carga en Configuración
/// → Página web → Paquetes. En la web se consulta por WhatsApp o email; no
/// se reserva online.
model Paquete {
  id          String   @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  fotoUrl     String?
  noches      Int?
  agencia     String?
  incluye     String[] @default([])
  /// En centavos de la moneda del hotel. null = "Consultar precio".
  precio      Int?
  /// 'persona' (por persona) o 'paquete' (precio total del paquete).
  precioModo  String   @default("persona")
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Un tipo de habitación de Hospi (Doble, Triple…) = un "room type" en Channex.
model ChannexTipo {
  id         String   @id @default(cuid())
  tenantId   String
  tipo       String
  roomTypeId String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo])
}

/// Una tarifa de Hospi para un tipo = un "rate plan" en Channex.
model ChannexTarifa {
  id         String   @id @default(cuid())
  tenantId   String
  tipo       String
  tarifaId   String
  ratePlanId String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo, tarifaId])
}

/// Cada novedad de una reserva que llegó desde un canal (nueva, modificada o
/// cancelada) y qué hizo Hospi con ella. Es la página "Reservas recibidas".
model ChannexReserva {
  id           String   @id @default(cuid())
  tenantId     String
  revisionId   String   @unique
  bookingId    String
  canal        String
  codigo       String?
  /// new | modified | cancelled (como lo manda Channex)
  novedad      String
  huesped      String
  checkin      DateTime
  checkout     DateTime
  habitaciones String
  /// importada | sin_lugar | error
  resultado    String
  detalle      String?
  reservaId    String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, bookingId])
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum EstadoHabitacion {
  Disponible
  Ocupada
  Limpieza
  Mantenimiento
  Reservada
  FueraDeServicio
}

enum EstadoPago {
  Pendiente
  Parcial
  Pagado
}

enum EstadoReserva {
  Confirmada
  Cancelada
  CheckIn_realizado
  Checkout_realizado
  AConfirmar
}

enum TipoTitular {
  empresa
  persona
}

enum EstadoTareaLimpieza {
  pendiente
  en_progreso
  completada
}

enum PlanType {
  basico
  profesional
  premium
  elite
  trial
}

enum RolTenant {
  owner
  admin
  recepcion
  limpieza
}

enum TipoComprobante {
  Factura
  Presupuesto
  Remito
  NotaCredito
  NotaDebito
}

enum TipoMetodoPago {
  efectivo
  tarjeta
  transferencia
  otro
}

enum TipoMovimientoCaja {
  ingreso
  egreso
}

// ═══════════════════════════════════════════════════════════
// PRESENCIA / ONLINE STATUS
// ═══════════════════════════════════════════════════════════

// UserPresence se eliminó: la presencia (quién está conectado) pasó a Redis.
// Era un upsert cada 30 s y un SELECT + DELETE cada 15 s por usuario, lo que
// mantenía la base de Neon despierta las 24 h y consumía todo el plan gratis.
// Ver src/lib/presence.ts.
