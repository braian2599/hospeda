// ==================== HOSPEDÁ — SCHEMA MULTI-TENANT ====================
// Cada tabla tiene tenantId para aislar datos por hotel/empresa.
// Sincronizado desde Neon PostgreSQL con enums y relaciones correctas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// TENANT & AUTH
// ═══════════════════════════════════════════════════════════

model Tenant {
  id             String            @id @default(cuid())
  nombre         String
  slug           String            @unique
  email          String
  telefono       String?
  direccion      String?
  pais           String            @default("Argentina")
  moneda         String            @default("ARS")
  timezone       String            @default("America/Argentina/Buenos_Aires")
  logoUrl        String?
  activo         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relaciones
  subscription    Subscription?
  users           TenantUser[]
  habitaciones    Habitacion[]
  clientes        Cliente[]
  reservas        Reserva[]
  pagos           Pago[]
  tarifas        Tarifa[]
  metodosPago    MetodoPago[]
  gastos         Gasto[]
  categoriasGasto CategoriaGasto[]
  movimientosCaja MovimientoCaja[]
  turnosCaja     TurnoCaja[]
  mantenimientos  Mantenimiento[]
  auditoria      Auditoria[]
  tareasLimpieza TareaLimpieza[]
  configuracion  TenantConfig?
  platformPayments PlatformPayment[]
}

// ═══════════════════════════════════════════════════════════
// PLANES & SUSCRIPCIONES
// ═══════════════════════════════════════════════════════════

model Plan {
  id              String         @id @default(cuid())
  type            PlanType       @unique
  nombre          String
  precioMensual   Int
  moneda          String         @default("ARS")
  maxHabitaciones Int
  maxUsuarios     Int
  maxTarifas      Int
  maxReservasMes  Int
  modulos         Json
  activo          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  planId            String
  estado            String    @default("trial")
  fechaInicio       DateTime  @default(now())
  fechaVencimiento  DateTime
  trialUsado        Boolean   @default(false)
  paymentProviderId String?
  canceladaAt       DateTime?
  esRecurrente      Boolean   @default(false)
  mpPlanId          String?
  mpPreapprovalId   String?   @unique
  proximoCobro      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan              Plan      @relation(fields: [planId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// USUARIOS & AUTH
// ═══════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  tenantId     String   @default("")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  password      String?
  phone         String?      @unique
  phoneVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]
  tenants       TenantUser[]
}

model TenantUser {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  rol            RolTenant @default(recepcion)
  nombreCompleto String?
  permisos       String[]
  activo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  password       String?

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// HABITACIONES
// ═══════════════════════════════════════════════════════════

model Habitacion {
  id                 String           @id @default(cuid())
  tenantId           String
  numero             String
  tipo               String
  capacidad          Int
  camasMatrimoniales Int
  camasSimples       Int
  estado             EstadoHabitacion @default(Disponible)
  problema           String?
  precioPorCama      Int?
  piso               Int?
  orden              Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numero])
}

// ═══════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════

model Cliente {
  id              String    @id @default(cuid())
  tenantId        String
  nombre          String
  dni             String
  telefono        String
  email           String?
  fechaNacimiento DateTime?
  nacionalidad    String?
  preferencias    String    @default("")
  domicilio       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estadias        Estadia[]
  reservas        Reserva[]

  @@unique([tenantId, dni])
}

model Estadia {
  id            String   @id @default(cuid())
  tenantId      String
  clienteId     String
  fechaCheckin  DateTime
  fechaCheckout DateTime
  habitacion    String
  gastoTotal    Int
  createdAt     DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// RESERVAS
// ═══════════════════════════════════════════════════════════

model Reserva {
  id                       String        @id @default(cuid())
  tenantId                 String
  clienteId                String?
  huesped                  String
  dni                      String
  telefono                 String
  email                    String?
  domicilio                String?
  habitacion               String
  checkin                  DateTime
  checkout                 DateTime
  personas                 Int
  estadoPago               EstadoPago    @default(Pendiente)
  estado                   EstadoReserva @default(Confirmada)
  tipoTarifa               String?
  metodoPagoId             String?
  cuotas                   Int?
  recargoPorcentaje        Int?
  notas                    String        @default("")
  observacionesHuesped     String?
  agenciaNombre            String?
  agenciaConvenio          String?
  agenciaVendedor          String?
  contactoEmergenciaNombre String?
  contactoEmergenciaTel    String?
  llaveEntregada           String?
  documentoVerificado      Boolean       @default(false)
  firmaConformidad         Boolean       @default(false)
  horaCheckin              String?
  horaCheckout             String?
  ninos                    Int?
  total                    Int?
  datosAdicionales         Json?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  acompanantes             Acompanante[]
  menores                  Menor[]
  pagos                    Pago[]
  cliente                  Cliente?      @relation(fields: [clienteId], references: [id])
  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, estado])
  @@index([tenantId, habitacion, checkin, checkout])
}

model Acompanante {
  id        String  @id @default(cuid())
  reservaId String
  nombre    String
  dni       String
  celular   String?

  reserva   Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)
}

model Menor {
  id         String  @id @default(cuid())
  reservaId  String
  nombre     String
  documento  String
  edad       Int
  parentesco String

  reserva    Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([reservaId])
}

// ═══════════════════════════════════════════════════════════
// PAGOS
// ═══════════════════════════════════════════════════════════

model Pago {
  id        String   @id @default(cuid())
  tenantId  String
  reservaId String
  monto     Int
  metodo    String
  nota      String   @default("")
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reservaId])
}

// ═══════════════════════════════════════════════════════════
// TARIFAS
// ═══════════════════════════════════════════════════════════

model Tarifa {
  id                   String   @id @default(cuid())
  tenantId             String
  nombre               String
  precios              Json
  camposPersonalizados Json?
  choferCortesia       Boolean  @default(false)
  habitacionChofer     String?
  activa               Boolean  @default(true)
  orden                Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MÉTODOS DE PAGO
// ═══════════════════════════════════════════════════════════

model MetodoPago {
  id        String         @id @default(cuid())
  tenantId  String
  nombre    String
  tipo      TipoMetodoPago
  recargo   Boolean        @default(false)
  cuotas    Json?
  activo    Boolean        @default(true)
  orden     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// CAJA
// ═══════════════════════════════════════════════════════════

model TurnoCaja {
  id                String           @id @default(cuid())
  tenantId          String
  estado            String           @default("abierta")
  montoInicial      Int
  empleadoId        String
  empleadoNombre    String
  fechaApertura     DateTime         @default(now())
  fechaCierre       DateTime?
  saldoEsperado     Int?
  saldoContado      Int?
  diferencia        Int?
  billetes          Json?
  totalOtrosMetodos Int?
  notas             String?
  discrepancyExplain String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  movimientos       MovimientoCaja[]
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MovimientoCaja {
  id             String             @id @default(cuid())
  tenantId       String
  turnoId        String
  tipo           TipoMovimientoCaja
  monto          Int
  descripcion    String             @default("")
  metodo         String             @default("Efectivo")
  empleadoId     String?
  empleadoNombre String
  reservaId      String?
  fecha          DateTime           @default(now())
  createdAt      DateTime           @default(now())
  gastoId        String?            @unique

  gasto          Gasto?             @relation(fields: [gastoId], references: [id])
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turno          TurnoCaja          @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@index([tenantId, turnoId])
  @@index([tenantId, gastoId])
}

// ═══════════════════════════════════════════════════════════
// GASTOS
// ═══════════════════════════════════════════════════════════

model Gasto {
  id             String          @id @default(cuid())
  tenantId       String
  tipo           String
  descripcion    String
  monto          Int
  fecha          DateTime
  empleadoId     String?
  empleado       String
  fuente         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  movimientoCaja MovimientoCaja?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fecha])
  @@index([tenantId, fuente])
}

model CategoriaGasto {
  id       String @id @default(cuid())
  tenantId String
  nombre   String
  orden    Int    @default(0)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MANTENIMIENTO
// ═══════════════════════════════════════════════════════════

model Mantenimiento {
  id         String   @id @default(cuid())
  tenantId   String
  habitacion String
  problema   String
  reparacion String?
  monto      Int?
  fecha      DateTime @default(now())
  empleado   String
  resuelto   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, resuelto])
}

// ═══════════════════════════════════════════════════════════
// LIMPIEZA
// ═══════════════════════════════════════════════════════════

model TareaLimpieza {
  id              String              @id @default(cuid())
  tenantId        String
  habitacion      String
  estado          EstadoTareaLimpieza @default(pendiente)
  prioridad       String              @default("normal")  // urgente, normal, baja
  tipo            String              @default("limpieza") // limpieza, mantenimiento, preparacion, inspeccion
  empleadoId      String?
  empleado        String?
  nota            String?
  fechaCreacion   DateTime            @default(now())
  fechaCompletado DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, estado])
}

// ═══════════════════════════════════════════════════════════
// AUDITORÍA
// ═══════════════════════════════════════════════════════════

model Auditoria {
  id         String   @id @default(cuid())
  tenantId   String
  tipo       String
  detalle    String
  empleadoId String?
  empleado   String
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACIÓN DEL TENANT
// ═══════════════════════════════════════════════════════════

model TenantConfig {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tema                String   @default("system")
  sidebarFijo         Boolean  @default(true)
  moduloInicio        String   @default("dashboard")
  hotelNombre         String?
  hotelDireccion      String?
  hotelCiudad         String?
  hotelPais           String?
  hotelTelefono       String?
  hotelEmail          String?
  hotelCuit           String?
  hotelIva            String?
  hotelLogoUrl        String?
  precioPorCamaGlobal Int?
  puntoVenta          Int?
  numeroFactura       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════
// SUPER ADMIN — CONFIGURACIÓN DE PLATAFORMA
// ═══════════════════════════════════════════════════════════

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PlatformPayment {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String
  monto          Int
  moneda         String   @default("ARS")
  metodo         String   @default("mercadopago")
  estado         String   @default("pendiente")
  periodoDesde   DateTime
  periodoHasta   DateTime
  externalId     String?
  nota           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([estado, createdAt])
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

enum EstadoHabitacion {
  Disponible
  Ocupada
  Limpieza
  Mantenimiento
  Reservada
  FueraDeServicio
}

enum EstadoPago {
  Pendiente
  Parcial
  Pagado
}

enum EstadoReserva {
  Confirmada
  Cancelada
  CheckIn_realizado
  Checkout_realizado
}

enum EstadoTareaLimpieza {
  pendiente
  en_progreso
  completada
}

enum PlanType {
  basico
  profesional
  premium
  trial
}

enum RolTenant {
  owner
  admin
  recepcion
  limpieza
}

enum TipoMetodoPago {
  efectivo
  tarjeta
  transferencia
  otro
}

enum TipoMovimientoCaja {
  ingreso
  egreso
}

// ═══════════════════════════════════════════════════════════
// PRESENCIA / ONLINE STATUS
// ═══════════════════════════════════════════════════════════

model UserPresence {
  id             String   @id @default(cuid())
  tenantUserId   String   @unique
  tenantId       String
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, lastSeenAt])
}
