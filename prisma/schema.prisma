// ==================== HOSPEDÁ — SCHEMA MULTI-TENANT ====================
// Cada tabla tiene tenantId para aislar datos por hotel/empresa.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// TENANT & AUTH
// ═══════════════════════════════════════════════════════════

model Tenant {
  id             String   @id @default(cuid())
  nombre         String   // Nombre del hotel / empresa
  slug           String   @unique // URL amigable: hospeda.com/app/[slug]
  email          String   // Email de contacto del hotel
  telefono       String?
  direccion      String?
  pais           String   @default("Argentina")
  moneda         String   @default("ARS")
  timezone       String   @default("America/Argentina/Buenos_Aires")
  logoUrl        String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  subscription   Subscription?
  users          TenantUser[]
  habitaciones   Habitacion[]
  clientes       Cliente[]
  reservas       Reserva[]
  pagos          Pago[]
  tarifas        Tarifa[]
  metodosPago    MetodoPago[]
  gastos         Gasto[]
  categoriasGasto CategoriaGasto[]
  movimientosCaja MovimientoCaja[]
  turnosCaja     TurnoCaja[]
  mantenimientos  Mantenimiento[]
  auditoria      Auditoria[]
  tareasLimpieza TareaLimpieza[]
  configuracion  TenantConfig?
  platformPayments PlatformPayment[]
}

// ═══════════════════════════════════════════════════════════
// PLANES & SUSCRIPCIONES
// ═══════════════════════════════════════════════════════════

// enum PlanType removed (SQLite doesn't support enums)
// Values were: basico, profesional, premium, trial

model Plan {
  id              String   @id @default(cuid())
  type            String @unique
  nombre          String
  precioMensual   Int      // En centavos para evitar floats
  moneda          String   @default("ARS")
  maxHabitaciones Int
  maxUsuarios     Int
  maxTarifas      Int
  maxReservasMes  Int      // 0 = ilimitado
  modulos         Json     // Array de ModuloId permitidos
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   Subscription[]
}

model Subscription {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  estado        String   @default("trial") // trial | pendiente_pago | activa | cancelada | vencida | suspensa
  fechaInicio   DateTime @default(now())
  fechaVencimiento DateTime
  trialUsado    Boolean  @default(false)
  paymentProviderId String? // ID en Mercado Pago / Stripe
  canceladaAt   DateTime?
  // ── Campos de suscripción recurrente (Mercado Pago Preapproval) ──
  mpPreapprovalId  String?  @unique  // ID del Preapproval en Mercado Pago
  mpPlanId        String?           // ID del Preapproval Plan en Mercado Pago
  esRecurrente     Boolean  @default(false) // true si es suscripción automática
  proximoCobro    DateTime?         // Próxima fecha de cobro (día 1 de cada mes)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// USUARIOS & AUTH
// ═══════════════════════════════════════════════════════════

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // oauth | credentials | phone
  provider          String  // google | email | phone
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  tenantId     String   // Para saber a qué hotel pertenece esta sesión

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String?   // Null si solo usa OAuth
  phone         String?   @unique
  phoneVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  tenants   TenantUser[]
}

// enum RolTenant removed (SQLite doesn't support enums)
// Values were: owner, admin, recepcion, limpieza

model TenantUser {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  rol             String @default("recepcion")
  nombreCompleto  String?
  password        String?   // Password propio del perfil (para login con usuario+contraseña)
  permisos        Json     // Array de ModuloId
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

}

// ═══════════════════════════════════════════════════════════
// HABITACIONES
// ═══════════════════════════════════════════════════════════

// enum EstadoHabitacion removed (SQLite doesn't support enums)
// Values were: Disponible, Ocupada, Limpieza, Mantenimiento, Reservada, FueraDeServicio

model Habitacion {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  numero           String   // "101", "201A", etc.
  tipo             String   // Doble, Triple, Cuádruple, Compartida, etc.
  capacidad        Int
  camasMatrimoniales Int
  camasSimples     Int
  estado           String @default("Disponible")
  problema         String?
  precioPorCama    Int?     // Solo para compartidas (en pesos, misma unidad que tarifas)
  piso             Int?
  orden            Int      @default(0) // Para ordenar visualmente
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, numero])
}

// ═══════════════════════════════════════════════════════════
// CLIENTES
// ═══════════════════════════════════════════════════════════

model Cliente {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  nombre          String
  dni             String
  telefono        String
  email           String?
  fechaNacimiento DateTime?
  nacionalidad    String?
  preferencias    String   @default("") // Texto libre
  domicilio       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reservas        Reserva[]
  estadias        Estadia[]

  @@unique([tenantId, dni])
}

model Estadia {
  id             String   @id @default(cuid())
  tenantId       String
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  fechaCheckin   DateTime
  fechaCheckout  DateTime
  habitacion     String
  gastoTotal     Int      // Centavos
  createdAt      DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// RESERVAS
// ═══════════════════════════════════════════════════════════

// enum EstadoReserva removed (SQLite doesn't support enums)
// Values were: Confirmada, Cancelada, CheckIn_realizado, Checkout_realizado

// enum EstadoPago removed (SQLite doesn't support enums)
// Values were: Pendiente, Parcial, Pagado

model Reserva {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id])
  clienteId         String?
  cliente           Cliente?      @relation(fields: [clienteId], references: [id])
  huesped           String        // Nombre del huésped (denormalizado para queries rápidas)
  dni               String
  telefono          String
  email             String?
  domicilio         String?
  habitacion        String
  checkin           DateTime
  checkout          DateTime
  personas          Int           // Cantidad de adultos
  ninos             Int?          // Cantidad de niños (para precio diferenciado)
  total             Int?          // Total en centavos (incluye adultos + niños + promociones)
  estadoPago        String    @default("Pendiente")
  estado            String @default("Confirmada")
  tipoTarifa        String?       // "normal", "agencia", etc.
  metodoPagoId      String?
  cuotas            Int?
  recargoPorcentaje Int?          // En centésimas (ej: 10 = 10%)
  notas             String        @default("")
  observacionesHuesped String?
  agenciaNombre     String?
  agenciaConvenio   String?
  agenciaVendedor   String?
  contactoEmergenciaNombre String?
  contactoEmergenciaTel    String?
  llaveEntregada     String?
  documentoVerificado Boolean @default(false)
  firmaConformidad  Boolean @default(false)
  horaCheckin       String?  // "14:30"
  horaCheckout      String?  // "11:00"
  datosAdicionales Json?         // Campos personalizados por tarifa (agencia, etc.)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pagos             Pago[]
  acompanantes      Acompanante[]
  menores           Menor[]

  @@index([tenantId, estado])
  @@index([tenantId, habitacion, checkin, checkout])
}

model Acompanante {
  id       String @id @default(cuid())
  reservaId String
  reserva  Reserva @relation(fields: [reservaId], references: [id])
  nombre   String
  dni      String
  celular  String?
}

model Menor {
  id         String @id @default(cuid())
  reservaId  String
  reserva    Reserva @relation(fields: [reservaId], references: [id])
  nombre     String
  documento  String
  edad       Int
  parentesco String

  @@index([reservaId])
}

// ═══════════════════════════════════════════════════════════
// PAGOS
// ═══════════════════════════════════════════════════════════

model Pago {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  reservaId String
  reserva   Reserva  @relation(fields: [reservaId], references: [id])
  monto     Int      // Centavos
  metodo    String   // ID del método de pago o nombre
  nota      String   @default("")
  fecha     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([tenantId, reservaId])
}

// ═══════════════════════════════════════════════════════════
// TARIFAS
// ═══════════════════════════════════════════════════════════

model Tarifa {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  nombre           String   // "normal", "agencia", "corporativo", etc.
  precios          Json     // { "modoCobro": "porGrupo", "rangos": [{ "minPersonas": 1, "maxPersonas": 2, "precio": 35000 }] }
  camposPersonalizados Json?  // [{ nombre, tipo, requerido }]
  choferCortesia   Boolean  @default(false)
  habitacionChofer String?
  activa           Boolean  @default(true)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MÉTODOS DE PAGO
// ═══════════════════════════════════════════════════════════

// enum TipoMetodoPago removed (SQLite doesn't support enums)
// Values were: efectivo, tarjeta, transferencia, otro

model MetodoPago {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  nombre    String
  tipo      String
  recargo   Boolean        @default(false)
  cuotas    Json?          // [{ cantidad: 1, porcentaje: 0 }, ...]
  activo    Boolean        @default(true)
  orden     Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// CAJA
// ═══════════════════════════════════════════════════════════

// enum TipoMovimientoCaja removed (SQLite doesn't support enums)
// Values were: ingreso, egreso

model TurnoCaja {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  estado         String   @default("abierta") // abierta | cerrada
  montoInicial   Int      // Centavos
  empleadoId     String   // TenantUser.id
  empleadoNombre String
  fechaApertura  DateTime @default(now())
  fechaCierre    DateTime?
  saldoEsperado  Int?
  saldoContado   Int?
  diferencia     Int?
  billetes       Json?    // { "20000": 3, "10000": 5, ... }
  totalOtrosMetodos Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movimientos    MovimientoCaja[]
}

model MovimientoCaja {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  turnoId      String
  turno        TurnoCaja @relation(fields: [turnoId], references: [id])
  tipo         String
  monto        Int      // Centavos
  descripcion  String   @default("")
  metodo       String   @default("Efectivo")
  empleadoId   String?
  empleadoNombre String
  reservaId    String?  // Si el ingreso viene de un pago de reserva
  gastoId      String?  @unique  // Si el egreso creó un Gasto (link 1:1 bidireccional)
  gasto        Gasto?   @relation(fields: [gastoId], references: [id])
  fecha        DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([tenantId, turnoId])
  @@index([tenantId, gastoId])
}

// ═══════════════════════════════════════════════════════════
// GASTOS (Reportes)
// ═══════════════════════════════════════════════════════════

model Gasto {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  tipo        String
  descripcion String
  monto       Int      // Centavos
  fecha       DateTime
  empleadoId      String?
  empleado        String
  fuente          String?  // 'caja' | 'pago_aparte' - null = legado sin fuente
  movimientoCaja  MovimientoCaja?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, fecha])
  @@index([tenantId, fuente])
}

model CategoriaGasto {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  nombre   String
  orden    Int    @default(0)

  @@unique([tenantId, nombre])
}

// ═══════════════════════════════════════════════════════════
// MANTENIMIENTO
// ═══════════════════════════════════════════════════════════

model Mantenimiento {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  habitacion  String
  problema    String
  reparacion  String?
  monto       Int?     // Centavos
  fecha       DateTime @default(now())
  empleado    String
  resuelto    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, resuelto])
}

// ═══════════════════════════════════════════════════════════
// LIMPIEZA
// ═══════════════════════════════════════════════════════════

// enum EstadoTareaLimpieza removed (SQLite doesn't support enums)
// Values were: pendiente, en_progreso, completada

model TareaLimpieza {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  habitacion  String
  estado      String @default("pendiente")
  empleadoId  String?
  empleado    String?
  nota        String?
  fechaCreacion DateTime          @default(now())
  fechaCompletado DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId, estado])
}

// ═══════════════════════════════════════════════════════════
// AUDITORÍA
// ═══════════════════════════════════════════════════════════

model Auditoria {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tipo      String   // "reserva_creada", "checkin_realizado", etc.
  detalle   String
  empleadoId String?
  empleado  String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ═══════════════════════════════════════════════════════════
// CONFIGURACIÓN DEL TENANT
// ═══════════════════════════════════════════════════════════

model TenantConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  // Preferencias generales
  tema            String   @default("system") // light | dark | system
  sidebarFijo     Boolean  @default(true)
  moduloInicio    String   @default("dashboard")
  // Datos del hotel para comprobos
  hotelNombre     String?
  hotelDireccion  String?
  hotelCiudad     String?
  hotelPais       String?
  hotelTelefono   String?
  hotelEmail      String?
  hotelCuit       String?
  hotelIva        String?  // "Responsable Inscripto", "Monotributo", etc.
  hotelLogoUrl    String?
  // Precio global por cama para habitaciones compartidas (en pesos, misma unidad que tarifas)
  // Se usa como fallback cuando una habitación compartida no tiene precioPorCama individual
  precioPorCamaGlobal Int?
  // Facturación
  puntoVenta      Int?
  numeroFactura   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
// SUPER ADMIN — CONFIGURACIÓN DE PLATAFORMA
// ═══════════════════════════════════════════════════════════

model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model PlatformPayment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  subscriptionId  String
  monto           Int      // Centavos
  moneda          String   @default("ARS")
  metodo          String   @default("mercadopago") // mercadopago | transferencia | manual
  estado          String   @default("pendiente")   // pendiente | pagado | fallido | devuelto
  periodoDesde    DateTime
  periodoHasta    DateTime
  externalId      String?  // ID en Mercado Pago
  nota            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([estado, createdAt])
}